# Dependencies / builds
node_modules/
dist/
dist-diag/
vite.config.js.timestamp-*

# TF.js WASM binaries (copied from node_modules by postinstall)
/public/tfjs-wasm/

# Study artifacts regenerated by scripts (hashes are tracked in the manifests)
/public/data/*.u8
/public/data/*.u32
/public/weights/*.bin
/downloads/

# Python
.venv/
__pycache__/

# Results, reports and per-device settings: kept on disk, never pushed
/results/
/reports/
/ACM_Web_2027_WebGPU/
device.local.json
logs/
*.log

# Planning notes (not pushed)
CLAUDE.local.md
.claude/
plans/
PLAN*.md
plan*.md
TODO*.md
NOTES*.md

# Pinned tools copied into the project (Chrome for Testing, Firefox, geckodriver)
tools/

# OS files
.DS_Store
Thumbs.db

# Environment lock: records the commit it was frozen at (a copy is written into every study folder)
env.lock.json
